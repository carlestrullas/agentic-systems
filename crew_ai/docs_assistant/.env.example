# Copy this file to .env and choose ONE option for the LLM and ONE for the
# embedder. .env is git-ignored, so your keys never get committed.

# ── LLM, option A: local model with Ollama (free, no API key) ────────────────
# Install Ollama (https://ollama.com), then: ollama pull llama3.1:8b
MODEL=ollama/llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM, option B: hosted model with an API key ──────────────────────────────
# Comment out the MODEL line above, uncomment one MODEL line below and fill in
# the API key of the same provider.
# MODEL=gpt-4o-mini
# MODEL=anthropic/claude-sonnet-4-5
# MODEL=gemini/gemini-2.0-flash
# MODEL=groq/llama-3.3-70b-versatile

# OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME
# GEMINI_API_KEY=REPLACE_ME
# GROQ_API_KEY=REPLACE_ME

# ── Embedder: the model that turns text into vectors ─────────────────────────
# Independent from MODEL: you can mix a hosted LLM with local embeddings.
# Local (default): ollama pull nomic-embed-text
EMBEDDER=ollama/nomic-embed-text
# EMBEDDER=openai/text-embedding-3-small     # needs OPENAI_API_KEY
# EMBEDDER=gemini/gemini-embedding-001       # needs GEMINI_API_KEY
# Anthropic has no embedding models: with Claude as MODEL, keep a local embedder.
