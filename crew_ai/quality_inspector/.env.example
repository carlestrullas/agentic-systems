# Copy this file to .env and fill in ONE of the options below.
# .env is git-ignored, so your keys never get committed.
#
# This example sends an image to the model, so MODEL must be a VISION model.
# Unlike the other examples, the default is a hosted model.

# ── Option A: hosted vision model with an API key (recommended) ─────────────
# Keep one MODEL line and fill in the API key of the same provider.
MODEL=gpt-4o-mini
# MODEL=anthropic/claude-sonnet-4-5
# MODEL=gemini/gemini-2.0-flash

OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME
# GEMINI_API_KEY=REPLACE_ME

# ── Option B: local vision model with Ollama (experimental) ─────────────────
# CrewAI only sends images to local models it recognises as vision models,
# such as llava or qwen3-vl: ollama pull llava:7b
# MODEL=ollama/llava:7b
OLLAMA_BASE_URL=http://localhost:11434
