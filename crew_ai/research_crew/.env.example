# Copy this file to .env and choose ONE of the two LLM options below.
# .env is git-ignored, so your keys never get committed.

# ── Option A: local model with Ollama (free, no API key) ─────────────────────
# Install Ollama (https://ollama.com), then: ollama pull llama3.1:8b
# This crew uses tools, so use a model of ~7-8B parameters or larger.
MODEL=ollama/llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ── Option B: hosted model with an API key ───────────────────────────────────
# Comment out the MODEL line above, uncomment one MODEL line below and fill in
# the API key of the same provider.
# MODEL=gpt-4o-mini
# MODEL=anthropic/claude-sonnet-4-5
# MODEL=gemini/gemini-2.0-flash
# MODEL=groq/llama-3.3-70b-versatile

# OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME
# GEMINI_API_KEY=REPLACE_ME
# GROQ_API_KEY=REPLACE_ME

# ── Web search (used by the researcher and the fact-checker) ─────────────────
# Free key at https://serper.dev. Works with both options above.
# Without it the crew still runs, but without access to the internet.
SERPER_API_KEY=REPLACE_ME
