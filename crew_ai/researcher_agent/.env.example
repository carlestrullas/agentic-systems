# Copy this file to .env and replace the placeholder values.
# .env is git-ignored, so your keys never get committed.

# Model to use, in "provider/model" format (or just the model name for OpenAI).
# Examples: gpt-4o-mini | anthropic/claude-sonnet-4-5 | gemini/gemini-2.0-flash
MODEL=gpt-4o-mini

# API key for the provider of the model above (fill in only the one you use)
OPENAI_API_KEY=REPLACE_ME
# ANTHROPIC_API_KEY=REPLACE_ME
# GEMINI_API_KEY=REPLACE_ME

# Optional: web search via https://serper.dev (free tier available).
# Without it, the agent answers from the model's own knowledge.
SERPER_API_KEY=REPLACE_ME
